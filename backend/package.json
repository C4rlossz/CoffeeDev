{
  "name": "coffeedev-administration",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "node bootstrap-owner.mjs",
    "test": "node --test test/domain.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-coffeedev --only firestore,auth \"node --test --test-concurrency=1 test/firestore.test.mjs test/bootstrap.test.mjs\" --config ../firebase.json"
  },
  "dependencies": {
    "firebase-admin": "14.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.1.0",
    "firebase-tools": "15.34.0"
  },
  "version": "1.2.0",
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
